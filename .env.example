# Public: Supabase project URL (server-side Postgres access)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key: used from server routes. Schema RLS policies allow exactly the
# reads/writes the app performs and nothing more.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Optional: if set (not a placeholder), takes precedence over the publishable key
# and bypasses RLS. Keep it server-side only.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session identifier + optional starting question index
SESSION_ID=catalygn-edge-workshop-1
SESSION_START_INDEX=0
