# Public: Supabase project URL + anon key (used for Realtime broadcast only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: service role key. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Controller authentication (server-side only)
CONTROLLER_SECRET=use-a-long-random-string-min-24-chars
CONTROLLER_NAME=Aaditya

# Session identifier + optional starting question index
SESSION_ID=catalygn-edge-workshop-1
SESSION_START_INDEX=0
